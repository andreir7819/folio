# Copy this file to .env.local after creating the Folio Supabase project.
# These values are safe to expose to the browser only when Row Level Security
# is enabled. Never place a Supabase secret key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
